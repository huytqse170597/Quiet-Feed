{
  "manifest_version": 3,
  "name": "Quiet Feed",
  "short_name": "Quiet Feed",
  "version": "2.1.0",
  "description": "A local feed cleaner for Facebook reels, sponsored posts, recommendations, and other distractions.",
  "minimum_chrome_version": "111",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://m.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://www.messenger.com/*",
    "https://messenger.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": [
        "src/legacy/facebook-react-hook-runtime.js",
        "src/privacy-page.js",
        "src/facebook-theme-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "src/shared/video.js",
        "src/video-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/filter-rules.js",
        "src/facebook-theme.js",
        "src/content.js",
        "src/video-content.js"
      ],
      "run_at": "document_start",
      "css": [
        "src/shared/feed-theme.css"
      ]
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "src/filter-rules.js",
        "src/page-hook.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": [
        "src/shared/features.js",
        "src/privacy-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Quiet Feed",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Open Quiet Feed popup"
    },
    "toggle-clean-mode": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Toggle Clean Mode on/off"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
